    "cheerio": "^1.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "google-auth-library": "^10.5.0",
    "node-fetch": "^2.7.0",
    "node-telegram-bot-api": "^0.64.0"
  },
  "devDependencies": {
